# Copy to /etc/wanderlog-mcp.env as root (chmod 600), then replace placeholders.
AUTH0_DOMAIN=YOUR_TENANT.REGION.auth0.com
MCP_PUBLIC_URL=https://mcp.738ngx.site/wanderlog/mcp
# Find the user's exact ID in Auth0 User Management, for example auth0|123...
AUTH0_ALLOWED_SUBJECTS=REPLACE_WITH_EXACT_AUTH0_USER_ID
ALLOWED_HOSTS=mcp.738ngx.site,localhost,127.0.0.1
